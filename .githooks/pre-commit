#!/bin/sh
# Versión del sitio (deuda AB, ver AUDITORIA/DESARROLLO_PARALELO.md).
# Si el commit cambia páginas, scripts o estilos, actualiza version.json para que el
# Workspace avise "Hay una versión nueva — Recargar" cuando se publique.
if git diff --cached --name-only | grep -qiE '\.(html|js|css)$'; then
  printf '{ "version": "%s" }\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > version.json
  git add version.json
fi
