{
  "metadata_definition": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "required_fields",
      "field_definitions"
    ],
    "properties": {
      "required_fields": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "field_definitions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "created_at",
          "parsed_at",
          "confidence"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "enum"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "string"
                ]
              },
              "enum": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "gpt",
                    "manual",
                    "notion",
                    "srp"
                  ]
                }
              },
              "nullable": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "created_at": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "nullable"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ISO_8601"
                ]
              },
              "nullable": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "parsed_at": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "nullable"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ISO_8601"
                ]
              },
              "nullable": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "min",
              "max",
              "nullable"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "number"
                ]
              },
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "maximum": 1
              },
              "nullable": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  },

  "root_structure": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "protocol_version",
      "courses"
    ],
    "properties": {
      "schema_version": {
        "type": "string"
      },
      "protocol_version": {
        "type": "string"
      },
      "courses": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "course_name",
            "categories"
          ],
          "properties": {
            "course_name": {
              "type": "string"
            },
            "categories": {
              "type": "object"
            },
            "metadata": {
              "type": "object",
              "nullable": true
            }
          }
        }
      }
    }
  },

  "item_structure": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "entity_type",
      "category_id",
      "text",
      "status",
      "subitems",
      "relations",
      "events",
      "ownership",
      "metadata"
    ],
    "properties": {
      "id": {
        "type": "string"
      },

      "parser_generated_id": {
        "type": "string",
        "nullable": true,
        "default": null
      },

      "parent_id": {
        "type": "string",
        "nullable": true,
        "default": null
      },

      "entity_type": {
        "type": "string"
      },

      "category_id": {
        "type": "string"
      },

      "text": {
        "type": "string",
        "minLength": 1
      },

      "normalized_text": {
        "type": "string",
        "nullable": false
      },

      "status": {
        "type": "string",
        "enum": [
          "pendiente",
          "realizado",
          "cancelado",
          "postergado",
          "recurrente",
          "archivado"
        ],
        "default": "pendiente"
      },

      "subitems": {
        "type": "array",
        "items": {
          "$ref": "#/subitem_structure"
        }
      },

      "relations": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation_type",
            "source_id",
            "target_id"
          ],
          "properties": {
            "relation_type": {
              "type": "string",
              "enum": [
                "item_dependency",
                "derived_from",
                "related_message",
                "related_evaluation",
                "duplicated_from",
                "merged_into",
                "linked_course"
              ]
            },
            "source_id": {
              "type": "string"
            },
            "target_id": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "nullable": true
            }
          }
        }
      },

      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "timestamp"
          ],
          "properties": {
            "event_type": {
              "type": "string",
              "enum": [
                "created",
                "updated",
                "completed",
                "archived",
                "synced",
                "imported",
                "parsed",
                "merged",
                "conflict_detected"
              ]
            },
            "timestamp": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "nullable": true
            },
            "metadata": {
              "type": "object",
              "nullable": true
            }
          }
        }
      },

      "ownership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_system",
          "parser_generated",
          "gpt_generated",
          "notion_generated",
          "user_generated"
        ],
        "properties": {
          "created_by": {
            "type": "string",
            "nullable": true
          },
          "modified_by": {
            "type": "string",
            "nullable": true
          },
          "source_system": {
            "type": "string",
            "enum": [
              "gpt",
              "srp",
              "notion",
              "manual"
            ]
          },
          "parser_generated": {
            "type": "boolean",
            "default": false
          },
          "gpt_generated": {
            "type": "boolean",
            "default": false
          },
          "notion_generated": {
            "type": "boolean",
            "default": false
          },
          "user_generated": {
            "type": "boolean",
            "default": false
          }
        }
      },

      "metadata": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },

  "subitem_structure": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "parent_id",
      "text",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "parent_id": {
        "type": "string"
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "pendiente",
          "realizado",
          "cancelado",
          "postergado",
          "recurrente",
          "archivado"
        ],
        "default": "pendiente"
      }
    }
  },

  "validation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "severity_levels",
      "field_validation",
      "entity_validation",
      "schema_validation",
      "validation_rules",
      "recovery_rules"
    ],
    "properties": {
      "severity_levels": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "fatal"
          ]
        }
      },

      "field_validation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },

      "entity_validation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },

      "schema_validation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },

      "validation_rules": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course_must_exist",
          "category_must_exist",
          "item_text_required"
        ],
        "properties": {
          "course_must_exist": {
            "type": "boolean"
          },
          "category_must_exist": {
            "type": "boolean"
          },
          "item_text_required": {
            "type": "boolean"
          }
        }
      },

      "recovery_rules": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recover_missing_bullets",
          "recover_missing_dates",
          "recover_missing_categories"
        ],
        "properties": {
          "recover_missing_bullets": {
            "type": "boolean"
          },
          "recover_missing_dates": {
            "type": "boolean"
          },
          "recover_missing_categories": {
            "type": "boolean"
          }
        }
      }
    }
  },

  "notion_sync_model": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "notion_page_id",
      "notion_database_id",
      "sync_direction",
      "sync_status"
    ],
    "properties": {
      "notion_page_id": {
        "type": "string",
        "nullable": true,
        "default": null
      },

      "notion_database_id": {
        "type": "string",
        "nullable": true,
        "default": null
      },

      "last_sync_at": {
        "type": "string",
        "nullable": true,
        "default": null
      },

      "sync_direction": {
        "type": "string",
        "enum": [
          "push",
          "pull",
          "bidirectional"
        ]
      },

      "sync_status": {
        "type": "string",
        "enum": [
          "pending",
          "synced",
          "conflict",
          "failed"
        ]
      },

      "merge_strategy": {
        "type": "string",
        "nullable": true
      },

      "overwrite_policy": {
        "type": "string",
        "nullable": true
      },

      "conflict_resolution": {
        "type": "string",
        "nullable": true
      }
    }
  }
}